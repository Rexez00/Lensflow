# Required — Postgres connection string (Neon free tier works: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Required — random secret for sessions (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Required on Netlify so Auth.js trusts the deployment host
AUTH_TRUST_HOST=true
# Public site URL (links, Stripe redirects, affiliate links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional — Stripe test keys. Without them, checkout uses the DemoPay test rail.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Seed admin (used only by db:seed on an empty database)
ADMIN_EMAIL=admin@lensflow.shop
ADMIN_PASSWORD=admin123
