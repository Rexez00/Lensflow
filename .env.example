# Required — Postgres connection string.
# Local via Docker: postgresql://lensflow:lensflow@localhost:5432/lensflow
# Production: Neon free tier works (https://neon.tech), pooled, ?sslmode=require
DATABASE_URL=postgresql://lensflow:lensflow@localhost:5432/lensflow
# Required — random secret for sessions (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Required on Netlify/Vercel so Auth.js trusts the deployment host
AUTH_TRUST_HOST=true
# Public site URL (links, Stripe redirects, affiliate links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional — Stripe test keys. Without them, checkout uses the DemoPay test rail + COD.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional — Morocco CMI (not yet wired to a live gateway).
# Get these from your CMI merchant account, then implement lib/cmi.ts.
CMI_MERCHANT_ID=
CMI_SECRET_KEY=
# Seed admin (used only by db:seed on an empty database)
ADMIN_EMAIL=admin@lensflow.shop
ADMIN_PASSWORD=admin123
